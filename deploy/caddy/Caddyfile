# Caddy terminates TLS for the workshop hostname and proxies to the containers.
# It obtains and renews a Let's Encrypt certificate automatically, and redirects
# http:// to https:// on its own.
#
# This requires bhl-workshop.iphylo.org to resolve DIRECTLY to this box
# (Cloudflare grey cloud / "DNS only"). If the record is proxied (orange cloud),
# Let's Encrypt's HTTP-01 challenge is answered by Cloudflare rather than by
# Caddy and issuance fails.
bhl-workshop.iphylo.org {
	# CouchDB, reached through this same TLS endpoint. handle_path strips the
	# prefix, so /_couch/bhl-lite arrives at CouchDB as /bhl-lite.
	#
	# Why: port 5984 is no longer published to the host, so CouchDB is not on
	# the public internet at all. Replication from the Mini now travels over
	# 443, which restrictive networks (eduroam and similar) do not block the way
	# they block odd ports. Nothing in a browser ever talks to CouchDB -- the
	# PHP talks to it over the internal Docker network -- so this path exists
	# solely for replication from the Mini.
	handle_path /_couch/* {
		reverse_proxy couchdb:5984
	}

	# CouchDB's replicator authenticates by POSTing to /_session at the HOST
	# ROOT, not under the target's path prefix, so proxying CouchDB only at
	# /_couch/ makes replication fail with replication_auth_error. Route the
	# root /_session to CouchDB as well. No site uses this path -- the demos all
	# live under /bhl-*/ -- so there is no collision.
	handle /_session* {
		reverse_proxy couchdb:5984
	}

	handle {
		reverse_proxy web:80
	}

	encode zstd gzip

	log {
		output file /data/access.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}
