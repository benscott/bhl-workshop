# Secrets — never commit
.env
**/env.php

# Cloned site code (managed by bootstrap.sh)
sites/

# Heavy data that gets synced, not committed
*.db
*.db-shm
*.db-wal
couch-data/
# written by the CouchDB entrypoint; contains the admin password
couchdb/local.d/docker.ini
caddy-data/
caddy-config/

.DS_Store
