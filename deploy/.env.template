# Copy to .env on the Hetzner box and fill in. NEVER commit .env.
# These are injected into the web container as environment variables; the PHP
# sites read them via getenv() (so you do NOT deploy per-site env.php files).

# --- CouchDB ---
COUCHDB_PROTOCOL=http://
COUCHDB_HOST=couchdb
COUCHDB_PORT=5984
COUCHDB_USERNAME=admin
COUCHDB_PASSWORD=change-me

# --- bhl-light ---
# Required: imgproxy signs the image URLs, so images break without these.
IMGPROXY_KEY=
IMGPROXY_SALT=
# Optional: read by the code but empty on the Mini too, so the live site runs
# without them. THUNDERFOREST_API_KEY only affects the map tile layer.
DATALAB_API_KEY=
THUNDERFOREST_API_KEY=
# Vestigial: set on the Mini, but no bhl-light code path reads it (only
# env-template.php mentions it). Left here for parity; safe to leave empty.
BHL_APIKEY=

# --- bhl-mcp ---
# Both optional: leave empty and the defaults are right for the workshop.
# The SPARQL endpoint the MCP server wraps (Andra Waagmeester's BHL graph).
BHL_SPARQL_ENDPOINT=
# Seconds to wait on that endpoint. Empty means "work it out from
# max_execution_time" (25s in this container). Do not raise it past the
# container's own limit: under Apache a request killed mid-flight returns an
# HTML 503, which no MCP client can parse.
BHL_HTTP_TIMEOUT=

# --- bhl-image-search --- (populate from its local env.php on the Mini)
# index.php falls back to getenv(), so these container vars are all it needs —
# do NOT deploy an env.php to the server.
# Required: the search API rejects requests when its own key is set.
BHL_SEARCH_API=http://YOUR-HETZNER-IP:8000
BHL_SEARCH_KEY=
