# Copy to .env on the Hetzner box and fill in. NEVER commit .env.
# These are injected into the web container as environment variables; the PHP
# sites read them via getenv() (so you do NOT deploy per-site env.php files).

# --- CouchDB ---
COUCHDB_PROTOCOL=http://
COUCHDB_HOST=couchdb
COUCHDB_PORT=5984
COUCHDB_USERNAME=admin
COUCHDB_PASSWORD=change-me

# --- bhl-light: BHL API + imgproxy ---
BHL_APIKEY=
IMGPROXY_KEY=
IMGPROXY_SALT=
DATALAB_API_KEY=

# --- bhl-image-search --- (populate from its local env.php on the Mini)
# index.php falls back to getenv(), so these container vars are all it needs —
# do NOT deploy an env.php to the server.
BHL_SEARCH_API=http://YOUR-HETZNER-IP:8000
BHL_SEARCH_KEY=
